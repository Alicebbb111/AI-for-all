{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnitransit.local/schemas/event-context-v1.schema.json",
  "title": "OmniTransit Traffic Event 1.0",
  "type": "object",
  "required": ["eventName", "eventType", "eventStatus", "verificationStatus"],
  "properties": {
    "eventId": {"type": "string"},
    "eventName": {"type": "string", "maxLength": 200},
    "eventType": {"enum": ["concert", "marathon", "public_event", "road_closure", "road_construction", "traffic_diversion", "other_traffic_disruption"]},
    "eventDate": {"type": ["string", "null"], "format": "date"},
    "startTime": {"type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "endTime": {"type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "location": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "affectedRoads": {"type": "array", "items": {"type": "string"}},
    "eventStatus": {"enum": ["confirmed", "planned", "possible", "cancelled", "postponed", "no_road_closure", "unknown"]},
    "sourceUrl": {"type": ["string", "null"], "format": "uri"},
    "publishedAt": {"type": ["string", "null"], "format": "date-time"},
    "extractionConfidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "verificationStatus": {"type": "string"},
    "roadClosureConfirmed": {"type": "boolean"}
  },
  "additionalProperties": true
}
