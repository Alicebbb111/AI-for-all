# ── OmniTransit v5 — ตัวแปรสภาพแวดล้อม ──────────────────────────────────────
# คัดลอกไฟล์นี้เป็น ".env" แล้วกรอกค่า (ระบบจะอ่านอัตโนมัติตอนเริ่มเซิร์ฟเวอร์)

# OpenAI API Key สำหรับระบบคาดการณ์ความแน่น/ผู้โดยสารด้วย AI จริง (ตัวเลือก — ไม่ใส่ก็ใช้ระบบส่วนอื่นได้ปกติ)
# รับ Key ได้ที่ https://platform.openai.com/api-keys
OPENAI_API_KEY=

# โมเดลที่ต้องการใช้: gpt-4o-mini (ประหยัดสุด) หรือ gpt-4o (แม่นขึ้น)
OPENAI_MODEL=gpt-4o-mini

# พอร์ตของเซิร์ฟเวอร์ (ค่าเริ่มต้น 8787)
PORT=8787

# Bus Bunching integration: separate sender and operator credentials.
# Required for writes in production; blank permits only loopback in development.
TELEMETRY_TOKEN=
OPERATIONS_TOKEN=

# Only list stops approved by an operator as safe for holding. Empty = no holding.
HOLDING_STOP_IDS=
